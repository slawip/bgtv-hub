# Copy to .env and adjust. Everything is optional.

# Addresses your devices use to reach the services (no trailing slash).
# Needed for working logos in IPTV apps and for the bridge stream in Stremio.
ADDON_PUBLIC_URL=http://192.168.1.10:7000
BRIDGE_PUBLIC_URL=http://192.168.1.10:7001

# Secret used to sign proxy links. Leave empty for a random one on each start.
# Generate one with: openssl rand -hex 32
PROXY_SECRET=

# Source website (only change this if the site moves).
SOURCE_URL=https://www.seirsanduk.online
